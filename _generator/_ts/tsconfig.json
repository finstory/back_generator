{
  "target": "es2016",
  "module": "commonjs",
  "compilerOptions": {
    "baseUrl": "./src",
    "paths": {
      //% Root :
      "@/*": ["./*"],
      "@app/*": ["./app/*"],
      "@ms/*": ["./_microservices/*"],
      //% Errors :
      "@throw_error": [
        "./_config/server/response/errors/errors.response.ts"
      ],
      "@throw_error_response_wrap": [
        "./_config/server/response/errors/throw-error-wrapper.response.ts"
      ],
      //% Services :
      "@services_injector": ["./_config/services/ServicesInjector.ts"],
      "@services": ["./_config/services/AllServices.ts"],

      //% Config :
      "@config/*": ["./_config/*"],

      //% Modules :
      "@user/*": ["./app/user/*"]
    },
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": false,
    "resolveJsonModule": true
  },
  "plugins": [
    /* Transform paths in output .js files */
    {
      "transform": "typescript-transform-paths"
    }
  ]
}
