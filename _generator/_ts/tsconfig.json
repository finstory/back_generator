{
  "extends": "./tsconfig.path.json",
  "target": "ES2017",
  "module": "commonjs",
  "lib": ["es2017"],
  "noUnusedLocals": true,
  "compilerOptions": {
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": false,
    "resolveJsonModule": true
  },

  "plugins": [{ "transform": "typescript-transform-paths" }]
}
