{
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@app/*": ["./src/app/*"],
      
      "@S": ["./src/services/all-services.ts"],
      "@services/*": ["./src/services/*"],
      "@services_injector": ["./src/_common/config/services/service-injector.ts"],
      
      "@routes/*": ["./src/_common/routes/*"],
      "@config/*": ["./src/_common/config*"],
      "@helpers/*": ["./src/_common/helpers/*"],
      "@components": ["./src/components"],
      "@redux_config": ["./src/_common/config/redux/decorators/redux-config.ts"],
      "@services_config/*": ["./src/_common/config/services/*"],

      "@route/*" : ["./src/app/route/*"],
      "@module/*" : ["./src/app/module/*"]
    }
  }
}