\t\\t\\t\\\"$align-items:${3:flex-start};\\\",\\n\\t\\t\\t\\\"$flex-direction:${4:row};\\\",\\n\\t\\t\\t\\\"\\\",\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"\\\"\\n},\\n\\n\\\"border_basic\\\" :{\\n\\t\\\"prefix\\\": \\\"xborder\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"$border: ${1:}px ${3:solid} #${2:FFFFFF};\\\",\\n\\t\\t\\t\\\"\\\",\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"\\\"\\n},\\n\\n\\\"size_basic\\\" :{\\n\\t\\\"prefix\\\": \\\"xsize\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"position: ${1:static};\\\",\\n\\t\\t\\t\\\"width: ${2:auto};\\\",\\n\\t\\t\\t\\\"height: ${3:auto};\\\",\\n\\t\\t\\t\\\"min-height: ${4:auto};\\\",\\n\\t\\t\\t\\\"max-width:${5:auto};\\\",\\n\\t\\t\\t\\\"\\\",\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"\\\"\\n},\\n\\n\\\"img_basic\\\" :{\\n\\t\\\"prefix\\\": \\\"ximg\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"display: block;\\\",\\n\\t\\t\\t\\\"width: ${2:100%};\\\",\\n\\t\\t\\t\\\"height: ${3:auto};\\\",\\n\\t\\t\\t\\\"\\\",\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"\\\"\\n},\\n\\n\\t\\\"display Flex\\\": {\\n\\t\\t\\\"prefix\\\": \\\"flex - inline-flex                            || Qflex\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"${1: /** FLEX = ocupa todo el bloque. \\\\n ** INLINE-FLEX = el pading depende de los elementos */}\\\",\\n\\t\\t\\t\\\"$display:${2:flex,inline};\\\"\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"agrega algo\\\"\\n\\t},\\n\\n\\t\\\"rrisd Flex\\\": {\\n\\t\\t\\\"prefix\\\": \\\"flex - inline-flex                            || Qflex\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"${1: /** FLEX = ocupa todo el bloque. \\\\n ** INLINE-FLEX = el pading depende de los elementos */}\\\",\\n\\t\\t\\t\\\"$display:${2:flex,inline};\\\"\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"agrega algo\\\"\\n\\t}\\n\\n}\\n\",\"javascript.json\":\"{\\n\\t// Place your snippets for javascript here. Each snippet is defined under a snippet name and has a prefix, body and \\n\\t// description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:\\n\\t// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the \\n\\t// same ids are connected.\\n\\t// Example:\\n\\t// \\\"Print to console\\\": {\\n\\t// \\t\\\"prefix\\\": \\\"log\\\",\\n\\t// \\t\\\"body\\\": [\\n\\t// \\t\\t\\\"console.log('$1');\\\",\\n\\t// \\t\\t\\\"$2\\\"\\n\\t// \\t],\\n\\t// \\t\\\"description\\\": \\\"Log output to console\\\"\\n\\t// }\\n}\",\"javascriptreact.json\":\"{\\n\\t\\\"React Native Functional Component\\\": {\\n\\t\\\"prefix\\\": \\\"rnfc\\\",\\n\\t\\\"body\\\": [\\n\\t  \\\"import React from 'react';\\\",\\n\\t  \\\"import { View, Text } from 'react-native';\\\",\\n\\t  \\\"\\\",\\n\\t  \\\"export const ${TM_FILENAME_BASE} = () => {\\\",\\n\\t  \\\"  return (\\\",\\n\\t  \\\"    <View>\\\",\\n\\t  \\\"      <Text>${TM_FILENAME_BASE}</Text>\\\",\\n\\t  \\\"    </View>\\\",\\n\\t  \\\"  );\\\",\\n\\t  \\\"};\\\",\\n\\t  \\\"\\\"\\n\\t],\\n\\t\\\"description\\\": \\\"Create a React Native functional component\\\"\\n  }\\n}\",\"typescript.json\":\"{\\n\\t// Place your snippets for typescript here. Each snippet is defined under a snippet name and has a prefix, body and \\n\\t// description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:\\n\\t// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the \\n\\t// same ids are connected.\\n\\t// Example:\\n\\t// \\\"Print to console\\\": {\\n\\t// \\t\\\"prefix\\\": \\\"log\\\",\\n\\t// \\t\\\"body\\\": [\\n\\t// \\t\\t\\\"console.log('$1');\\\",\\n\\t// \\t\\t\\\"$2\\\"\\n\\t// \\t],\\n\\t// \\t\\\"description\\\": \\\"Log output to console\\\"\\n\\t// }\\n}\",\"typescriptreact.json\":\"{\\n\\t\\\"TS Children Functional Component\\\": {\\n\\t\\t\\\"prefix\\\": \\\"raft_scss\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"import React, { FC } from 'react';\\\",\\n\\t\\t\\t\\\"\\\",\\n\\t\\t\\t\\\"interface IProps {\\\",\\n\\t\\t\\t\\\"  _scss: CSSModuleClasses;\\\",\\n\\t\\t\\t\\\"}\\\",\\n\\t\\t\\t\\\"\\\",\\n\\t\\t\\t\\\"const ${TM_FILENAME_BASE}: FC<IProps> = ({ _scss }) => {\\\",\\n\\t\\t\\t\\\"  return (\\\",\\n\\t\\t\\t\\\"    <div className={_scss.${1:}}>\\\",\\n\\t\\t\\t\\\"      ${TM_FILENAME_BASE}\\\",\\n\\t\\t\\t\\\"    </div>\\\",\\n\\t\\t\\t\\\"  );\\\",\\n\\t\\t\\t\\\"};\\\",\\n\\t\\t\\t\\\"\\\",\\n\\t\\t\\t\\\"export default ${TM_FILENAME_BASE};\\\"\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"Creates a React Functional Component with SCSS\\\"\\n\\t},\\n\\t\\\"TS Functional Component\\\": {\\n\\t\\t\\\"prefix\\\": \\\"raft\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"import React, { FC } from 'react';\\\",\\n\\t\\t\\t\\\"//import scss from 'you_scss_file';\\\",\\n\\t\\t\\t\\\"const scss: any = {};\\\",\\n\\t\\t\\t\\\"\\\",\\n\\t\\t\\t\\\"interface IProps {\\\",\\n\\t\\t\\t\\\"}\\\",\\n\\t\\t\\t\\\"\\\",\\n\\t\\t\\t\\\"const ${TM_FILENAME_BASE}: FC<IProps> = ({ }) => {\\\",\\n\\t\\t\\t\\\"    return (\\\",\\n\\t\\t\\t\\\"        <div className={scss.${1:}}>\\\",\\n\\t\\t\\t\\\"            ${TM_FILENAME_BASE}\\\",\\n\\t\\t\\t\\\"        </div>\\\",\\n\\t\\t\\t\\\"    );\\\",\\n\\t\\t\\t\\\"};\\\",\\n\\t\\t\\t\\\"\\\",\\n\\t\\t\\t\\\"export default ${TM_FILENAME_BASE};\\\"\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"Creates a React Functional Component with SCSS\\\"\\n\\t}\\n}\"}}","extensions":"[{\"identifier\":{\"id\":\"aaron-bond.better-comments\",\"uuid\":\"7a0110bb-231a-4598-aa1b-0769ea46d28b\"},\"displayName\":\"Better Comments\"},{\"identifier\":{\"id\":\"albert.tabout\",\"uuid\":\"4ef6c2d5-de36-45a1-9015-18c1d4a3a25e\"},\"displayName\":\"TabOut\"},{\"identifier\":{\"id\":\"alefragnani.project-manager\",\"uuid\":\"1b747f06-3789-4ebd-ac99-f1fe430c3347\"},\"displayName\":\"Project Manager\"},{\"identifier\":{\"id\":\"anseki.vscode-color\",\"uuid\