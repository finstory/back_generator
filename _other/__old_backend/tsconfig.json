{
  "target": "es2016",
  "module": "commonjs",
  "extends": "./tsconfigpath.json",

  "compilerOptions": {
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": false,
    "resolveJsonModule": true
  },

  "plugins": [{ "transform": "typescript-transform-paths" }]
}
