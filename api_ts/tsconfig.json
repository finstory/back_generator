{
  "target": "es2016",
  "module": "commonjs",
  "compilerOptions": {
    "baseUrl": "./src",
    "paths": {
      "@/*": ["./*"],
      "@app/*": ["./app/*"],
      "@config/*": ["./_config/*"],
      "@user/*": ["./app/user/*"]
    },
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": false,
    "resolveJsonModule": true
  },
  "plugins": [
    /* Transform paths in output .js files */
    {
      "transform": "typescript-transform-paths"
    }
  ]
}
